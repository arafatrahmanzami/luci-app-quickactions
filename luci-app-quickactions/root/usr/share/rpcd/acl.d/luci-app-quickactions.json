{
	"luci-app-quickactions": {
		"description": "Grant access to Quick Actions",
		"read": {
			"ubus": {
				"file": [
					"exec",
					"read"
				],
				"luci": [
					"getInitList",
					"getThemes"
				],
				"luci.quickactions-taskplan": [
					"*"
				]
			},
			"file": {
				"/etc/crontabs/root": [
					"read"
				],
				"/etc/config/hotplug": [
					"read"
				],
				"/etc/quickactions-taskplan/taskplan.log": [
					"read"
				],
				"/etc/quickactions-taskplan/taskplancustomscript": [
					"read"
				],
				"/etc/quickactions-taskplan/taskplancustomscript2": [
					"read"
				],
				"/etc/config/taskplan": [
					"read"
				],
				"/etc/config/wizard": [
					"read"
				],
				"/etc/config/netwizard": [
					"read"
				],
				"/etc/config/network": [
					"read"
				],
				"/etc/config/firewall": [
					"read"
				],
				"/etc/config/dhcp": [
					"read"
				],
				"/etc/config/wireless": [
					"read"
				],
				"/etc/config/nginx": [
					"read"
				],
				"/etc/config/uhttpd": [
					"read"
				],
				"/etc/config/lighttpd": [
					"read"
				],
				"/usr/libexec/quickactions-netwizard/list-backups.sh": [
					"exec"
				],
				"/bin/sh -c *": [
					"exec"
				]
			},
			"uci": [
				"luci",
				"quickactions",
				"hotplug",
				"guestwifi",
				"network",
				"wireless",
				"dhcp",
				"firewall",
				"taskplan",
				"wizard",
				"netwizard",
				"nginx"
			],
			"execute": {
				"/usr/libexec/quickactions-netwizard/list-backups.sh": [
					"exec"
				]
			}
		},
		"write": {
			"ubus": {
				"file": [
					"exec",
					"read",
					"write"
				],
				"uci": [
					"*"
				],
				"luci.quickactions-taskplan": [
					"*"
				]
			},
			"file": {
				"/etc/crontabs/root": [
					"write"
				],
				"/etc/config/hotplug": [
					"write"
				],
				"/etc/quickactions-taskplan/taskplan.log": [
					"write"
				],
				"/etc/quickactions-taskplan/taskplancustomscript": [
					"write"
				],
				"/etc/quickactions-taskplan/taskplancustomscript2": [
					"write"
				],
				"/etc/config/taskplan": [
					"write"
				],
				"/etc/config/wizard": [
					"write"
				],
				"/etc/config/netwizard": [
					"write"
				],
				"/etc/config/network": [
					"write"
				],
				"/etc/config/firewall": [
					"write"
				],
				"/etc/config/dhcp": [
					"write"
				],
				"/etc/config/wireless": [
					"write"
				],
				"/etc/config/nginx": [
					"write"
				],
				"/etc/config/uhttpd": [
					"write"
				],
				"/etc/config/lighttpd": [
					"write"
				],
				"/usr/libexec/quickactions-netwizard/*": [
					"exec"
				],
				"/bin/sh -c *": [
					"exec"
				],
				"/etc/init.d/cron restart": [
					"exec"
				]
			},
			"uci": [
				"luci",
				"quickactions",
				"hotplug",
				"guestwifi",
				"network",
				"wireless",
				"dhcp",
				"firewall",
				"taskplan",
				"wizard",
				"netwizard",
				"nginx"
			],
			"execute": {
				"/etc/init.d/quickactions-taskplan": [
					"start",
					"stop",
					"restart",
					"reload"
				],
				"/usr/libexec/quickactions-netwizard/apply-aggressive.sh": [
					"exec"
				],
				"/usr/libexec/quickactions-netwizard/backup.sh": [
					"exec"
				],
				"/usr/libexec/quickactions-netwizard/restore.sh": [
					"exec"
				],
				"/usr/libexec/quickactions-netwizard/apply-shortcuts.sh": [
					"exec"
				]
			}
		}
	}
}

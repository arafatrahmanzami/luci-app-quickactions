{
	"luci-app-quickactions": {
		"description": "Grant access to Quick Actions",
		"read": {
			"ubus": {
				"file": [ "exec", "read" ],
				"luci": [ "getInitList", "getThemes" ]
			},
			"file": {
				"/etc/crontabs/root": [ "read" ],
				"/etc/config/hotplug": [ "read" ]
			},
			"uci": [ "luci", "quickactions", "hotplug", "guestwifi", "network", "wireless", "dhcp", "firewall" ]
		},
		"write": {
			"ubus": {
				"file": [ "exec", "read", "write" ],
				"uci": [ "*" ]
			},
			"file": {
				"/etc/crontabs/root": [ "write" ],
				"/etc/config/hotplug": [ "write" ]
			},
			"uci": [ "luci", "quickactions", "hotplug", "guestwifi", "network", "wireless", "dhcp", "firewall" ]
		}
	}
}
